{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrgBot",
  "version": "0.1.0",
  "identifier": "io.orgbot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OrgBot",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Bot rooms that work your projects",
    "longDescription": "GPTBots desktop: rooms of AI agents (codex, claude, grok, API bots) that share a task board and work a project folder together."
  }
}